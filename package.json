{
  "name": "code-editor",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy": "ng build --configuration production && node scripts/deploy.js"
  },
  "private": true,
  "browser": {
    "path": "path-browserify"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0",
    "pnpm": ">=9.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^20.19.0 || ^22.12.0 || ^24.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.12.0",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@angular/animations": "21.2.9",
    "@angular/common": "21.2.9",
    "@angular/compiler": "21.2.9",
    "@angular/core": "21.2.9",
    "@angular/forms": "21.2.9",
    "@angular/platform-browser": "21.2.9",
    "@angular/router": "21.2.9",
    "@fortawesome/fontawesome-free": "7.3.0",
    "angular-split": "20.0.0",
    "bootstrap": "5.3.8",
    "monaco-editor": "0.55.1",
    "ngx-monaco-editor-v2": "21.1.4",
    "path-browserify": "1.0.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.9",
    "@angular/cli": "21.2.9",
    "@angular/compiler-cli": "21.2.9",
    "@types/jasmine": "5.1.4",
    "jasmine-core": "5.1.2",
    "typescript": "5.9.3"
  }
}
